# Supabase Configuration
# Get these values from your Supabase project settings: https://app.supabase.com

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Auth account used by the app's hidden login.
# This must match a real user in Supabase Dashboard -> Authentication -> Users,
# otherwise inserts fail with "new row violates row-level security policy".
VITE_DIARY_ACCOUNT_EMAIL=deepnectar@diary-app.local
VITE_DIARY_ACCOUNT_PASSWORD=DeepuH@2805
